# Copy to deploy/.env. Names only; never commit real secrets.
POSTGRES_PASSWORD=postgres
HUDDLE_POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/postgres
HUDDLE_REDIS_URL=redis://redis:6379/0
HUDDLE_JWT_SECRET=change-me
HUDDLE_SERVICE_TOKEN=change-me
HUDDLE_CHAT_URL=http://chat:8001
HUDDLE_GATEWAY_ID=gw-1
HUDDLE_OLLAMA_URL=http://host.docker.internal:11434
HUDDLE_DECIDER_MODEL=llama3.2:3b
HUDDLE_WRITER_MODEL=llama3.1:8b
HUDDLE_SESSION_ID=ses_main
HUDDLE_SESSION_TITLE=Huddle
HUDDLE_CORS_ORIGINS=http://localhost:5173
HUDDLE_BUDGET_CAPACITY_TOKENS=500000
HUDDLE_BUDGET_WINDOW_SECONDS=86400
HUDDLE_CHAT_MIGRATE_ON_STARTUP=1
HUDDLE_FALLBACK_MODEL=
