# Rendered by the nginx image's entrypoint (envsubst on ${HUDDLE_*}); nginx's own $variables are
# left alone because only variables present in the environment are substituted.
upstream huddle_chat { server ${HUDDLE_CHAT_UPSTREAM}; }
upstream huddle_gateway { server ${HUDDLE_GATEWAY_UPSTREAM}; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /nginx-health { access_log off; return 200 "ok\n"; }

    # REST API (chat service)
    location ~ ^/(auth|sessions)(/|$) {
        proxy_pass http://huddle_chat;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket (gateway). Any gateway can take any connection, so no stickiness is needed.
    location /ws {
        proxy_pass http://huddle_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;   # the gateway pings every 20 s
        proxy_send_timeout 3600s;
    }

    # The single-page app; hashed assets are immutable, index.html is never cached.
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
